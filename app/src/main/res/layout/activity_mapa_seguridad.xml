<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_surface"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:background="@drawable/bg_toolbar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="14dp">

        <Button
            android:id="@+id/btnVolverMapa"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@android:color/transparent"
            android:backgroundTint="@null"
            android:text="‹"
            android:textColor="@color/app_text_light"
            android:textSize="28sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:text="Mapa de seguridad"
            android:textColor="@color/app_text_light"
            android:textSize="17sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnRecargarMapa"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@android:color/transparent"
            android:backgroundTint="@null"
            android:text="↻"
            android:textColor="@color/app_text_light"
            android:textSize="20sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/txtEstadoMapa"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/app_surface"
        android:paddingStart="14dp"
        android:paddingTop="8dp"
        android:paddingEnd="14dp"
        android:paddingBottom="8dp"
        android:text="Cargando mapa..."
        android:textColor="@color/app_text_secondary"
        android:textSize="12sp" />

    <org.osmdroid.views.MapView
        android:id="@+id/mapViewSeguridad"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <Button
        android:id="@+id/btnCentrarMapa"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginStart="18dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="18dp"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_button_primary"
        android:backgroundTint="@null"
        android:text="Centrar en mi ubicación"
        android:textAllCaps="false"
        android:textColor="@color/app_text_light"
        android:textStyle="bold" />

</LinearLayout>
