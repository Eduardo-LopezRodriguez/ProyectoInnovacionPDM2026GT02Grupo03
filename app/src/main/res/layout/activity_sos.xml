<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_surface"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:background="@drawable/bg_toolbar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="14dp">

        <Button
            android:id="@+id/btnVolverSos"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@android:color/transparent"
            android:backgroundTint="@null"
            android:text="‹"
            android:textColor="@color/app_text_light"
            android:textSize="28sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:text="Alerta SOS"
            android:textColor="@color/app_text_light"
            android:textSize="17sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:background="@drawable/bg_icon_red"
            android:gravity="center"
            android:text="SOS"
            android:textColor="@color/app_danger"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtEstadoSos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Preparando alerta..."
            android:textAlignment="center"
            android:textColor="@color/app_text"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtCoordenadasSos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Latitud: --\nLongitud: --"
            android:textAlignment="center"
            android:textColor="@color/app_text_secondary"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnActivarSos"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="28dp"
            android:background="@drawable/bg_button_danger"
            android:backgroundTint="@null"
            android:text="Activar SOS"
            android:textAllCaps="false"
            android:textColor="@color/app_text_light"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnHistorialSos"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_button_outline"
            android:backgroundTint="@null"
            android:text="Ver historial"
            android:textAllCaps="false"
            android:textColor="@color/app_primary"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
