<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F6F8"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Lugar importante"
            android:textColor="#1E293B"
            android:textSize="24sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/edtNombreLugar"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="24dp"
            android:hint="Nombre del lugar"
            android:inputType="text"
            android:padding="14dp"
            android:background="@android:drawable/edit_text" />

        <EditText
            android:id="@+id/edtTipoLugar"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="14dp"
            android:hint="Tipo, ejemplo: Casa, Universidad, Trabajo"
            android:inputType="text"
            android:padding="14dp"
            android:background="@android:drawable/edit_text" />

        <EditText
            android:id="@+id/edtDireccionLugar"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="14dp"
            android:hint="Dirección"
            android:inputType="textPostalAddress"
            android:padding="14dp"
            android:background="@android:drawable/edit_text" />

        <EditText
            android:id="@+id/edtDepartamentoLugar"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="14dp"
            android:hint="Departamento"
            android:inputType="text"
            android:padding="14dp"
            android:background="@android:drawable/edit_text" />

        <EditText
            android:id="@+id/edtMunicipioLugar"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="14dp"
            android:hint="Municipio"
            android:inputType="text"
            android:padding="14dp"
            android:background="@android:drawable/edit_text" />

        <TextView
            android:id="@+id/txtCoordenadasLugar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Ubicación no seleccionada"
            android:textColor="#475569"
            android:textSize="15sp" />

        <Button
            android:id="@+id/btnSeleccionarUbicacionLugar"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:text="Seleccionar ubicación en mapa" />

        <Button
            android:id="@+id/btnGuardarLugar"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="24dp"
            android:text="Guardar lugar" />

        <Button
            android:id="@+id/btnCancelarLugar"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:text="Cancelar" />

    </LinearLayout>
</ScrollView>
