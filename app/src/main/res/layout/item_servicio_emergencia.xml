<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_card"
    android:elevation="3dp"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_icon_blue"
            android:padding="10dp"
            android:src="@drawable/ic_services" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtNombreServicio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Policía Nacional"
                android:textColor="@color/app_text"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtDetalleServicio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="POLICIA • 911"
                android:textColor="@color/app_text_secondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/txtDireccionServicio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Dirección, municipio, departamento"
                android:textColor="@color/app_text_secondary"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnLlamarServicio"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:background="@drawable/bg_button_outline"
            android:backgroundTint="@null"
            android:text="Llamar"
            android:textAllCaps="false"
            android:textColor="@color/app_primary"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnVerMapaServicio"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_button_outline"
            android:backgroundTint="@null"
            android:text="Ver en mapa"
            android:textAllCaps="false"
            android:textColor="@color/app_primary"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
