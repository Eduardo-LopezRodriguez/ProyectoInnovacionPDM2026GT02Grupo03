<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F6F8"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Contacto de confianza"
            android:textColor="#1E293B"
            android:textSize="24sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/edtNombreContacto"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="24dp"
            android:hint="Nombre completo"
            android:inputType="textPersonName"
            android:padding="14dp"
            android:background="@android:drawable/edit_text" />

        <EditText
            android:id="@+id/edtTelefonoContacto"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="14dp"
            android:hint="Teléfono"
            android:inputType="phone"
            android:padding="14dp"
            android:background="@android:drawable/edit_text" />

        <EditText
            android:id="@+id/edtCorreoContacto"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="14dp"
            android:hint="Correo opcional"
            android:inputType="textEmailAddress"
            android:padding="14dp"
            android:background="@android:drawable/edit_text" />

        <EditText
            android:id="@+id/edtParentescoContacto"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="14dp"
            android:hint="Parentesco"
            android:inputType="text"
            android:padding="14dp"
            android:background="@android:drawable/edit_text" />

        <EditText
            android:id="@+id/edtPrioridadContacto"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="14dp"
            android:hint="Prioridad, ejemplo: 1"
            android:inputType="number"
            android:padding="14dp"
            android:background="@android:drawable/edit_text" />

        <Button
            android:id="@+id/btnGuardarContacto"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="24dp"
            android:text="Guardar contacto" />

        <Button
            android:id="@+id/btnCancelarContacto"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:text="Cancelar" />

    </LinearLayout>
</ScrollView>
