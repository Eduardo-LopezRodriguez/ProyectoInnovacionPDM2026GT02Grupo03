<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_surface"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="26dp">

        <TextView
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:background="@drawable/bg_icon_blue"
            android:gravity="center"
            android:text="👤"
            android:textSize="32sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="Seguridad Personal"
            android:textAlignment="center"
            android:textColor="@color/app_text"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Tu seguridad, nuestra prioridad"
            android:textAlignment="center"
            android:textColor="@color/app_text_secondary"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Correo electrónico"
            android:textColor="@color/app_text"
            android:textSize="13sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/edtCorreo"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="7dp"
            android:background="@drawable/bg_input"
            android:hint="ejemplo@correo.com"
            android:inputType="textEmailAddress"
            android:textColor="@color/app_text"
            android:textColorHint="@color/app_text_secondary"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Contraseña"
            android:textColor="@color/app_text"
            android:textSize="13sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/edtPassword"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="7dp"
            android:background="@drawable/bg_input"
            android:hint="••••••••"
            android:inputType="textPassword"
            android:textColor="@color/app_text"
            android:textColorHint="@color/app_text_secondary"
            android:textSize="14sp" />

        <Button
            android:backgroundTint="@null"
            android:id="@+id/btnIngresar"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_button_primary"
            android:text="Ingresar"
            android:textAllCaps="false"
            android:textColor="@color/app_text_light"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtCrearCuenta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="46dp"
            android:padding="8dp"
            android:text="¿No tienes cuenta? Regístrate"
            android:textAlignment="center"
            android:textColor="@color/app_primary"
            android:textSize="13sp"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>

