<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_surface"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="78dp"
        android:background="@drawable/bg_toolbar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingEnd="18dp">

        <TextView
            android:layout_width="32dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="☰"
            android:textColor="@color/app_text_light"
            android:textSize="24sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtBienvenida"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Hola, Usuario"
                android:textColor="@color/app_text_light"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="¿En qué podemos ayudarte hoy?"
                android:textColor="#EAF0FF"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:layout_width="32dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="!"
            android:textColor="@color/app_text_light"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:alignmentMode="alignMargins"
        android:columnCount="2"
        android:padding="18dp"
        android:useDefaultMargins="true">

        <Button
            android:backgroundTint="@null"
            android:id="@+id/btnMapa"
            android:layout_width="0dp"
            android:layout_height="118dp"
            android:layout_columnWeight="1"
            android:background="@drawable/bg_dashboard_tile"
            android:drawableTop="@drawable/ic_map_pin"
            android:drawablePadding="8dp"
            android:elevation="5dp"
            android:gravity="center"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="12dp"
            android:text="Ver mapa"
            android:textAlignment="center"
            android:textAllCaps="false"
            android:textColor="@color/app_text"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Button
            android:backgroundTint="@null"
            android:id="@+id/btnSos"
            android:layout_width="0dp"
            android:layout_height="118dp"
            android:layout_columnWeight="1"
            android:background="@drawable/bg_dashboard_tile"
            android:drawableTop="@drawable/ic_sos"
            android:drawablePadding="8dp"
            android:elevation="5dp"
            android:gravity="center"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="12dp"
            android:text="Alerta SOS"
            android:textAlignment="center"
            android:textAllCaps="false"
            android:textColor="@color/app_danger"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Button
            android:backgroundTint="@null"
            android:id="@+id/btnContactos"
            android:layout_width="0dp"
            android:layout_height="118dp"
            android:layout_columnWeight="1"
            android:background="@drawable/bg_dashboard_tile"
            android:drawableTop="@drawable/ic_contacts"
            android:drawablePadding="8dp"
            android:elevation="5dp"
            android:gravity="center"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="12dp"
            android:text="Contactos"
            android:textAlignment="center"
            android:textAllCaps="false"
            android:textColor="@color/app_text"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Button
            android:backgroundTint="@null"
            android:id="@+id/btnLugares"
            android:layout_width="0dp"
            android:layout_height="118dp"
            android:layout_columnWeight="1"
            android:background="@drawable/bg_dashboard_tile"
            android:drawableTop="@drawable/ic_location"
            android:drawablePadding="8dp"
            android:elevation="5dp"
            android:gravity="center"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="12dp"
            android:text="Lugares"
            android:textAlignment="center"
            android:textAllCaps="false"
            android:textColor="@color/app_text"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Button
            android:backgroundTint="@null"
            android:id="@+id/btnServicios"
            android:layout_width="0dp"
            android:layout_height="118dp"
            android:layout_columnWeight="1"
            android:background="@drawable/bg_dashboard_tile"
            android:drawableTop="@drawable/ic_services"
            android:drawablePadding="8dp"
            android:elevation="5dp"
            android:gravity="center"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="12dp"
            android:text="Servicios"
            android:textAlignment="center"
            android:textAllCaps="false"
            android:textColor="@color/app_text"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Button
            android:backgroundTint="@null"
            android:id="@+id/btnHistorial"
            android:layout_width="0dp"
            android:layout_height="118dp"
            android:layout_columnWeight="1"
            android:background="@drawable/bg_dashboard_tile"
            android:drawableTop="@drawable/ic_history"
            android:drawablePadding="8dp"
            android:elevation="5dp"
            android:gravity="center"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="12dp"
            android:text="Historial"
            android:textAlignment="center"
            android:textAllCaps="false"
            android:textColor="@color/app_text"
            android:textSize="14sp"
            android:textStyle="bold" />
    </GridLayout>

    <Button
            android:backgroundTint="@null"
        android:id="@+id/btnCerrarSesion"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="18dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_button_outline"
        android:text="Cerrar sesión"
        android:textAllCaps="false"
        android:textColor="@color/app_primary"
        android:textSize="13sp"
        android:textStyle="bold" />
</LinearLayout>

